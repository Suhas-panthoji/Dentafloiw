# MongoDB
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
DB_NAME=dentaflow_db

# Auth
JWT_SECRET=your-secret-key-here

# Default Users
DOCTOR_EMAIL=doctor@clinic.com
DOCTOR_PASSWORD=doctor123
STAFF_EMAIL=staff@clinic.com
STAFF_PASSWORD=staff123
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=admin123

# Private file storage (use mock locally; set r2 only after adding every R2 value)
STORAGE_BACKEND=mock
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only used by mock mode; Render disk is ephemeral and must not be used in production.
MOCK_STORAGE_DIR=.mock-storage

# Resource Usage dashboard (server-side only; never expose these to the frontend)
# Render bandwidth API is optional; without it, response-byte usage is estimated locally.
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=srv_your_service_id

# CORS - comma-separated list of allowed frontend origins
# Set this to your Vercel deployment URL(s)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
